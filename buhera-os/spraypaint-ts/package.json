{
  "name": "@buhera/spraypaint",
  "version": "0.1.0",
  "description": "TypeScript bindings + crossfilter-to-query propagation for the spraypaint split-attention search binary.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runner-node": {
      "types": "./dist/runner-node.d.ts",
      "import": "./dist/runner-node.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18",
    "d3": ">=7"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "d3": { "optional": true }
  },
  "devDependencies": {
    "@types/d3": "^7",
    "@types/node": "^20",
    "@types/react": "^18",
    "d3": "^7",
    "react": "^18",
    "typescript": "^5"
  }
}
