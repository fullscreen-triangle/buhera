<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="https://w3id.org/nfdi4cat/transaminase-kg/ontology"
         xmlns="https://w3id.org/nfdi4cat/transaminase-kg/ontology#">

<owl:Ontology rdf:about="https://w3id.org/nfdi4cat/transaminase-kg/ontology"/>

<owl:ObjectProperty rdf:about="#hasSubstrate">
  <rdfs:domain rdf:resource="#Reaction"/>
  <rdfs:range rdf:resource="#ChemicalSpecies"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasProduct">
  <rdfs:domain rdf:resource="#Reaction"/>
  <rdfs:range rdf:resource="#ChemicalSpecies"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#catalyzedBy">
  <rdfs:domain rdf:resource="#Reaction"/>
  <rdfs:range rdf:resource="#Enzyme"/>
  <owl:inverseOf rdf:resource="#catalyzes"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#catalyzes">
  <rdfs:domain rdf:resource="#Enzyme"/>
  <rdfs:range rdf:resource="#Reaction"/>
  <owl:inverseOf rdf:resource="#catalyzedBy"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasCofactor">
  <rdfs:domain rdf:resource="#Enzyme"/>
  <rdfs:range rdf:resource="#Cofactor"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasAminoDonor">
  <rdfs:subPropertyOf rdf:resource="#hasSubstrate"/>
  <rdfs:domain rdf:resource="#Transamination"/>
  <rdfs:range rdf:resource="#ChemicalSpecies"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasAminoAcceptor">
  <rdfs:subPropertyOf rdf:resource="#hasSubstrate"/>
  <rdfs:domain rdf:resource="#Transamination"/>
  <rdfs:range rdf:resource="#ChemicalSpecies"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#reversible">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Reaction"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#mechanism">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Reaction"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:AnnotationProperty rdf:about="#ecNumber"/>

<owl:AnnotationProperty rdf:about="#keggReaction"/>

<owl:AnnotationProperty rdf:about="#systematicName"/>

<owl:Class rdf:about="#ChemicalSpecies">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Enzyme">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasCofactor"/>
      <owl:someValuesFrom rdf:resource="#Cofactor"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Cofactor">
  <rdfs:subClassOf rdf:resource="#ChemicalSpecies"/>
</owl:Class>

<owl:Class rdf:about="#Reaction">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Transamination">
  <rdfs:subClassOf rdf:resource="#Reaction"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#catalyzedBy"/>
      <owl:someValuesFrom rdf:resource="#Enzyme"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>


</rdf:RDF>
